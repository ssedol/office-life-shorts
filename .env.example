# 오늘도출근 Shorts Factory — 환경 변수 예시
#
# 이 파일을 .env로 복사해서 쓰세요. .env는 절대 커밋하지 않습니다 (명세서 §26).
#   cp .env.example .env
#
# MVP는 유료 API를 쓰지 않으므로 아래 값은 전부 선택 사항입니다.
# 계정 비밀번호와 결제정보는 어떤 경우에도 저장하지 않습니다 (명세서 §26).

# ComfyUI가 다른 PC나 다른 포트에 있을 때.
# 비워두면 config/i2v.json의 comfyui.baseUrl을 씁니다.
# COMFYUI_BASE_URL=http://127.0.0.1:8188

# 사내망 등 프록시 뒤에서 edge-tts를 쓸 때.
# config/tts.json의 engines.edge.proxy가 비어 있으면 이 값을 씁니다.
# HTTPS_PROXY=http://proxy.example.com:3128

# 향후 유료 TTS(예: Clova)를 붙일 때 쓸 자리. MVP에서는 쓰지 않습니다.
# CLOVA_CLIENT_ID=
# CLOVA_CLIENT_SECRET=
