{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shorts Script — 로컬 파이프라인 입력 파일",
  "description": "클로드가 만들고 로컬 PC가 읽는다. scenes 를 순서대로 돌면서 TTS·이미지·영상을 만들면 된다.",
  "type": "object",
  "required": ["id", "topic", "axis", "total_sec", "voice", "image_style", "scenes", "youtube"],
  "properties": {
    "id":        { "type": "string", "pattern": "^[0-9]{4}$" },
    "topic":     { "type": "string" },
    "axis":      { "type": "string", "enum": ["A", "B"], "description": "A=공감, B=꿀팁" },
    "category":  { "type": "string" },
    "total_sec": { "type": "number" },

    "voice": {
      "type": "object",
      "description": "TTS 설정. 로컬 TTS 엔진에 그대로 넘긴다.",
      "required": ["lang", "style", "speed"],
      "properties": {
        "lang":  { "type": "string", "default": "ko-KR" },
        "style": { "type": "string", "description": "목소리 톤 지시문" },
        "speed": { "type": "number", "default": 1.05 }
      }
    },

    "image_style": {
      "type": "string",
      "description": "모든 씬 이미지에 공통으로 붙일 스타일 문자열. 채널 톤 통일용."
    },

    "scenes": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["n", "role", "start", "end", "tts", "caption", "image_prompt", "motion"],
        "properties": {
          "n":     { "type": "integer", "minimum": 1 },
          "role":  { "type": "string", "enum": ["HOOK","SETUP","BODY1","BODY2","BODY3","PAYOFF","CTA"] },
          "start": { "type": "number" },
          "end":   { "type": "number" },
          "tts":   { "type": "string", "description": "TTS에 넣을 문장. 이것만 읽힌다." },
          "caption": { "type": "string", "description": "화면에 띄울 자막. 짧게, 12자 내외." },
          "image_prompt": { "type": "string", "description": "이미지 생성 모델에 넣을 영문 프롬프트. image_style 이 뒤에 붙는다." },
          "motion": { "type": "string", "enum": ["zoom_in","zoom_out","pan_left","pan_right","static"],
                      "description": "정지 이미지에 줄 움직임. static 연속 사용 금지." }
        }
      }
    },

    "youtube": {
      "type": "object",
      "required": ["title", "description", "tags", "pinned_comment", "made_for_kids"],
      "properties": {
        "title":          { "type": "string", "maxLength": 25 },
        "description":    { "type": "string" },
        "tags":           { "type": "array", "items": { "type": "string" } },
        "pinned_comment": { "type": "string" },
        "thumbnail_text": { "type": "string" },
        "made_for_kids":  { "type": "boolean", "const": false },
        "ai_disclosure":  { "type": "boolean", "description": "합성 음성/이미지 사용 시 true. 업로드 시 '변경된 콘텐츠' 고지 설정" }
      }
    },

    "hook_candidates": {
      "type": "array", "minItems": 3,
      "items": { "type": "object", "required": ["pattern","text"],
                 "properties": { "pattern": {"type":"string"}, "text": {"type":"string"} } }
    },
    "hook_chosen": { "type": "integer" },
    "status": { "type": "string", "enum": ["draft","validated","produced","published"] }
  }
}
