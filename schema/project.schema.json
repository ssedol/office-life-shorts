{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://today-to-work.local/schema/project.schema.json",
  "title": "project.json",
  "description": "오늘도출근 Shorts Factory 입력 패키지의 프로젝트 메타데이터 (명세서 §11)",
  "type": "object",
  "required": ["channel", "date", "title", "durationTargetSec", "sceneCount"],
  "additionalProperties": true,
  "properties": {
    "channel": {
      "type": "string",
      "minLength": 1,
      "description": "채널명. 명세서 DEC-001에 따라 '오늘도출근'."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "제작일. 출력 폴더명(outputs/YYYY-MM-DD)으로도 쓰인다."
    },
    "topic": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "durationTargetSec": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "목표 길이(초). 명세서 §8.1 권장 범위는 35~45초."
    },
    "sceneCount": {
      "type": "integer",
      "const": 8,
      "description": "명세서 §8.2 / §33-3 — 씬 수는 항상 8개."
    },
    "resolution": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "exclusiveMinimum": 0 },
        "height": { "type": "integer", "exclusiveMinimum": 0 }
      },
      "description": "명세서 §20 기본값 1080×1920. 생략하면 config/render.json 값을 쓴다."
    },
    "fps": { "type": "integer", "exclusiveMinimum": 0 },
    "tts": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "engine": {
          "type": "string",
          "enum": ["edge", "edge-tts", "supertonic", "cli", "offline"]
        },
        "voice": {
          "type": "string",
          "description": "'UNDECIDED'는 자리표시자로 취급해 config/tts.json 기본값을 쓴다 (명세서 §35-2)."
        },
        "speed": { "type": "number", "minimum": 0.5, "maximum": 2.0 }
      }
    },
    "renderMode": { "type": "string", "enum": ["preview", "final"] }
  }
}
